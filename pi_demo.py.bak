"""Chạy phát hiện té ngã trên Raspberry Pi.

    python pi_demo.py                    # Pi Camera (picamera2), không có thì dùng USB webcam
    python pi_demo.py video.mp4          # chạy trên file video (đo tốc độ + kiểm tra nhanh)
    python pi_demo.py --log run.csv      # ghi log từng frame để làm báo cáo

Cần các file cùng thư mục: fall_core.py, fall_config.json, movenet_lightning_int8.tflite, rf_fall.onnx
"""
import argparse
import functools
import json
import os
import time

import cv2
print = functools.partial(print, flush=True)  # in ngay, không mất chữ nếu tiến trình bị crash
from fall_core import MoveNet, FallDetector, onnx_predictor

ap = argparse.ArgumentParser()
ap.add_argument("video", nargs="?", help="file video; bỏ trống để dùng camera")
ap.add_argument("--threads", type=int, default=4)
ap.add_argument("--cam", type=int, default=0, help="chỉ số USB webcam khi không có Pi Camera")
ap.add_argument("--size", default="640x480", help="độ phân giải camera")
ap.add_argument("--log", help="ghi CSV: t, p_fall, state, pose_ms")
ap.add_argument("--save-alarm", action="store_true", help="lưu ảnh lúc báo động")
args = ap.parse_args()

cfg = json.load(open("fall_config.json"))
period = 1.0 / cfg["target_fps"]
pose = MoveNet(cfg["movenet"], num_threads=args.threads)
det = FallDetector(onnx_predictor(cfg["model"]), threshold=cfg["threshold"], win_s=cfg["win_s"],
                   stride_s=cfg["stride_s"], k=cfg["k"], n=cfg["n"], confirm_s=cfg["confirm_s"])


def frames_from_video(path):
    """Lấy mẫu frame theo thời gian của video về target_fps, giống hệt lúc train.
    t là thời gian trong video, không phải đồng hồ thật -> vận tốc rơi tính đúng dù Pi chạy nhanh hay chậm."""
    cap = cv2.VideoCapture(path)
    if not cap.isOpened():
        raise SystemExit(f"Không mở được video: {path}")
    vid_fps, idx, next_t = cap.get(cv2.CAP_PROP_FPS) or 30.0, -1, 0.0
    while True:
        ok, frame = cap.read()
        if not ok:
            break
        idx += 1
        t = idx / vid_fps   # thời gian theo số thứ tự frame (không dùng POS_MSEC)
        if t + 1e-6 < next_t:
            continue
        next_t += period
        yield t, frame


def frames_from_camera():
    w, h = map(int, args.size.split("x"))
    try:
        from picamera2 import Picamera2
        cam = Picamera2()
        # 'RGB888' của picamera2 nằm trong bộ nhớ theo thứ tự B,G,R -> đúng định dạng OpenCV
        cam.configure(cam.create_video_configuration(main={"size": (w, h), "format": "RGB888"}))
        cam.start()
        grab = cam.capture_array
        print(f"Dùng Pi Camera {w}x{h}")
    except Exception as e:
        print(f"Không dùng được Pi Camera ({e}) -> thử USB webcam {args.cam}")
        cap = cv2.VideoCapture(args.cam)
        cap.set(cv2.CAP_PROP_FRAME_WIDTH, w)
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, h)

        def grab():
            ok, frame = cap.read()
            if not ok:
                raise SystemExit("Không đọc được webcam")
            return frame
    t0, next_t = time.time(), 0.0
    while True:
        now = time.time() - t0
        if now < next_t:
            time.sleep(next_t - now)                           # giữ đúng target_fps như lúc train
        next_t = max(next_t + period, time.time() - t0)       # Pi chậm thì không dồn frame
        frame = grab()
        yield time.time() - t0, frame


src = frames_from_video(args.video) if args.video else frames_from_camera()
log = open(args.log, "w") if args.log else None
if log:
    log.write("t,p_fall,state,pose_ms\n")

tot_n, tot_ms, alarms = 0, 0.0, 0
win_n, win_ms, win_start = 0, 0.0, time.time()
run_start = time.time()
try:
    for t, frame in src:
        t1 = time.perf_counter()
        kps = pose(frame)
        ms = (time.perf_counter() - t1) * 1000
        if det.push(t, kps, frame.shape[0]) == "alarm":
            alarms += 1
            print(f"[{t:7.2f}s] PHÁT HIỆN TÉ NGÃ! (p_fall={det.last_prob:.2f})")
            if args.save_alarm:
                cv2.imwrite(f"fall_{time.strftime('%Y%m%d_%H%M%S')}.jpg", frame)
            # TODO: gửi Telegram / MQTT ở đây
        if log:
            log.write(f"{t:.3f},{det.last_prob:.3f},{det.state},{ms:.1f}\n")
        tot_n += 1; tot_ms += ms; win_n += 1; win_ms += ms
        if time.time() - win_start >= 5:
            print(f"FPS={win_n / (time.time() - win_start):.1f}  MoveNet={win_ms / win_n:.0f} ms  "
                  f"p_fall={det.last_prob:.2f}  state={det.state}")
            win_n, win_ms, win_start = 0, 0.0, time.time()
except KeyboardInterrupt:
    pass
finally:
    if log:
        log.close()
    if tot_n:
        el = time.time() - run_start
        print(f"\nTổng: {tot_n} frame trong {el:.1f}s | xử lý {tot_n / el:.1f} FPS | "
              f"MoveNet trung bình {tot_ms / tot_n:.0f} ms/frame | báo động: {alarms}")
    os._exit(0)  # thoát ngay, tránh crash khi giải phóng interpreter TFLite
